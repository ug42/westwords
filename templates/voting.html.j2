<div class="text-center p-3">
    <!-- Secret Word Banner -->
    <div class="mb-4">
        <h5 class="text-gold mb-1" style="font-family: var(--ww-font-heading); font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase;">The Secret Word Was</h5>
        <h3 class="text-light" style="font-family: var(--ww-font-heading); font-size: 1.8rem; letter-spacing: 0.05em; text-shadow: 0 0 10px var(--ww-accent-gold-glow);">
            "{{ word }}"
        </h3>
    </div>

    <!-- Voting prompt text -->
    <div class="p-3 mb-4 rounded border border-danger" style="background: rgba(166, 61, 64, 0.06); box-shadow: inset 0 0 10px rgba(166, 61, 64, 0.05); font-size: 1.1rem; color: var(--ww-danger-red-bright);">
        <span class="material-symbols-outlined d-block mb-1" style="font-size: 2rem; animation: pulse 1s infinite alternate;">gavel</span>
        {{ voting_text }}
    </div>

    <hr class="border-secondary my-3">

    <h6 class="text-muted mb-3" style="font-family: var(--ww-font-heading); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;">Condemn a Candidate</h6>
    
    <!-- Candidates target grid -->
    <div class="d-flex flex-wrap justify-content-center gap-2">
        {% for c in candidates %}
        <button type="button" class="btn btn-outline-danger py-2 px-4 close font-weight-bold" 
                onclick="vote_player('{{ game_id }}', '{{ c.sid }}')"
                style="letter-spacing: 0.05em; font-family: var(--ww-font-heading); min-width: 140px; border-color: var(--ww-danger-red); color: var(--ww-danger-red-bright);">
            {{ c.name }}
        </button>
        {% endfor %}
    </div>
</div>