<div class="p-3 text-center">
    <h5 class="text-gold mb-1" style="font-family: var(--ww-font-heading); font-size: 0.9rem; letter-spacing: 0.1em; text-transform: uppercase;">Next Active Inquiry</h5>
    <div class="mb-4">
        <span class="username" style="font-size: 1.15rem;">{{ question_object.player }}</span>
        <span class="text-muted">asks:</span>
        <blockquote class="blockquote mt-2 p-3 rounded" style="background: rgba(0,0,0,0.25); border-left: 3px solid var(--ww-accent-gold); font-size: 1.2rem; font-style: italic;">
            "{{ question_object.question }}"
        </blockquote>
    </div>

    <h6 class="text-muted mb-3" style="font-family: var(--ww-font-heading); font-size: 0.8rem; letter-spacing: 0.05em; text-transform: uppercase;">Bestow Your Answer Token</h6>
    <div class="d-flex flex-wrap justify-content-center gap-2 mb-3">
        {% for token in tokens %}
        <button onclick="answer('{{ game_id }}', {{ question_object.id }}, '{{ token.value }}')" 
                class="btn btn-outline-primary py-2 px-3 d-flex align-items-center gap-2"
                title="{{ token.token_text }}">
            <span style="font-size: 1.25rem;">{{ token.token_icon }}</span>
            <span style="font-size: 0.9rem; font-family: var(--ww-font-heading);">{{ token.token_text }}</span>
        </button>
        {% endfor %}
    </div>
    
    <div class="mt-3 pt-3 border-top border-secondary">
        <button onclick="skip_question('{{ game_id }}', {{ question_object.id }})" 
                class="btn btn-danger w-100 py-2">
            Skip / Dismiss Inquiry
        </button>
    </div>
</div>