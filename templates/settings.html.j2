{% extends "_layout.html.j2" %}
{% block body %}
<div class="container py-4" style="max-width: 600px;">
    <div class="ww-card p-4">
        <h2 class="text-gold border-bottom pb-2 mb-4 text-center" style="font-family: var(--ww-font-heading);">Realm Settings</h2>
        
        <!-- Toggle Autocomplete Form -->
        <form action="/toggle_autocomplete" id="toggle_autocomplete" target="hidden_frame" method="POST" class="mb-4">
            <div class="form-check p-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid var(--ww-border-subtle);">
                <input onclick="document.getElementById('toggle_autocomplete').submit();" type="checkbox" id="autocomplete"
                    class="form-check-input ms-0 me-3" {% if autocomplete_enabled %} checked{% endif %} 
                    style="transform: scale(1.3); cursor: pointer;">
                <label class="form-check-label text-light font-weight-bold ms-4" for="autocomplete" style="cursor: pointer; font-size: 1.05rem;">
                    Enable Inquiry Autocomplete
                    <small class="d-block text-muted font-weight-normal mt-1" style="font-size: 0.85rem;">Display suggestion list when asking questions</small>
                </label>
            </div>
        </form>
        
        <!-- Toggle Duplicate Warnings Form -->
        <form action="/toggle_check_for_duplicate" id="toggle_check_for_duplicate" target="hidden_frame" method="POST" class="mb-4">
            <div class="form-check p-3 rounded" style="background: rgba(255,255,255,0.02); border: 1px solid var(--ww-border-subtle);">
                <input onclick="document.getElementById('toggle_check_for_duplicate').submit();" type="checkbox"
                    id="check_for_duplicate" class="form-check-input ms-0 me-3" {% if check_for_duplicate %} checked{% endif %}
                    style="transform: scale(1.3); cursor: pointer;">
                <label class="form-check-label text-light font-weight-bold ms-4" for="check_for_duplicate" style="cursor: pointer; font-size: 1.05rem;">
                    Intercept Duplicate Inquiries
                    <small class="d-block text-muted font-weight-normal mt-1" style="font-size: 0.85rem;">Check for duplicate questions before allowing submit</small>
                </label>
            </div>
        </form>
        
        <hr class="border-secondary my-4">

        <!-- Theme Selection Form -->
        <div class="mb-4">
            <label for="selected_theme" class="form-label text-gold font-weight-bold" style="font-family: var(--ww-font-heading); font-size: 0.95rem; letter-spacing: 0.05em; text-transform: uppercase;">Aesthetic Art Theme</label>
            <form action="/theme" method="POST" target="hidden_frame" class="d-flex align-items-center gap-2">
                <select name="selected_theme" id="selected_theme" class="form-select flex-grow-1">
                    {% for theme in themes %}
                    <option value="{{ theme.name }}" {% if theme.directory == currently_selected_theme %} selected{% endif %}>
                        {{ theme.description }}
                    </option>
                    {% endfor %}
                </select>
                <button class="btn btn-primary" type="submit">Apply</button>
            </form>
        </div>
        
        <!-- Username Modification Form -->
        <div class="mb-4">
            <label for="username_input" class="form-label text-gold font-weight-bold" style="font-family: var(--ww-font-heading); font-size: 0.95rem; letter-spacing: 0.05em; text-transform: uppercase;">Identify Thyself</label>
            <form action="/username" id="username_change" method="POST" target="hidden_frame" class="d-flex align-items-center gap-2">
                <input class="form-control flex-grow-1" type="text" name="username" id="username_input"
                    value="{{ session.username }}" required autocomplete="off">
                <button class="btn btn-primary" type="submit">Rename</button>
            </form>
        </div>
        
        <hr class="border-secondary my-4">

        <!-- Back to Realm button -->
        <div class="text-center">
            <a href="/">
                <button class="btn btn-secondary w-100 py-3" style="font-family: var(--ww-font-heading); letter-spacing: 0.05em; text-transform: uppercase;">
                    Return to the Realm
                </button>
            </a>
        </div>
    </div>
</div>
{% endblock %}