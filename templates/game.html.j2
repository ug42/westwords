{% extends "_layout.html.j2" %}
{% block body %}

<div class="main container py-3">
    <!-- Glowing Timer Section -->
    <div class="text-center mb-4">
        <div class="game_timer mb-2">
            <div id="game_timer" class="game_timer" hidden>00:00</div>
        </div>
        <div class="d-flex justify-content-center">
            <div id="game_timer_settings" class="game_timer_settings" hidden
                onclick="let d = document.getElementById('timer_controls'); if (d.style.display === 'none') { d.style.display = 'block'; } else { d.style.display = 'none'; }">
                Timer Config
            </div>
        </div>
        
        <!-- Timer Settings Dropdown Card -->
        <div style="display: none; max-width: 400px; margin: 15px auto;" id="timer_controls" class="ww-card">
            <h5 class="text-gold mb-3" style="font-family: var(--ww-font-heading);">Realm Controls</h5>
            <div class="input-group mb-3">
                <input type="number" value="{{ game_timer }}" id="game_timer_input" class="form-control" placeholder="Seconds...">
                <button class="btn btn-primary" onclick="set_timer('{{ game_id }}', document.getElementById('game_timer_input').value);
                    document.getElementById('timer_controls').style.display = 'none';">Set Timer</button>
            </div>
            
            <div id="boot_players_content" class="content mt-3 text-start">
                <h6 class="text-gold mb-2" style="font-family: var(--ww-font-heading);">Exile Players</h6>
                {% for p in players %}
                <div class="d-flex align-items-center justify-content-between mb-2 p-2 border-bottom border-secondary">
                    <span>{{ p.name }}</span>
                    <button class="btn btn-danger btn-sm" title="Remove Player"
                        onclick="boot_player('{{ game_id }}', '{{ p.sid }}')">
                        Exile
                    </button>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Active Roles Selection Grid (Setup Phase) -->
    <div id="roles" class="ww-card mb-4" hidden></div>

    <!-- Player Information & Game Lobby -->
    <div id="player_info" class="ww-card mb-4" hidden>
        <h4 class="text-gold border-bottom pb-2 mb-3" style="font-family: var(--ww-font-heading);">Townspeople &amp; Wanderers</h4>
        <div id="players"></div>
    </div>

    <!-- Interactive Game Action Center -->
    <div class="ww-card mb-4">
        <h4 class="text-gold border-bottom pb-2 mb-3" style="font-family: var(--ww-font-heading);">Game Operations</h4>
        
        <!-- Admin start/reset controls -->
        <div style="display:inline;" id="admin_controls" hidden>
            <button onclick="send_start_req('{{ game_id }}')"
                class="btn btn-success me-2"
                id="game_start">Commence Game</button>
            <button onclick="send_reset_req('{{ game_id }}')"
                class="btn btn-danger" id="game_reset"
                hidden>Reset Realm</button>
        </div>
        
        <!-- Player Lobby controls -->
        <div style="display:inline;" id="controls" hidden>
            <button class="btn btn-primary me-2"
                id="nominate_for_mayor">Claim Mayoralty</button>
            <button onclick="window.location.href='/join/{{ game_id }}'"
                class="btn btn-success me-2" id="join_game"
                hidden>Join Game</button>
            <button id="show_role_button" class="btn btn-outline-primary" onclick="showMyRole()">Reveal My Role</button>
            
            <!-- Question Submission Block -->
            <div id="question_input" class="mt-4" hidden>
                <div class="form-group">
                    <label for="question" class="form-label text-gold font-weight-bold" style="font-family: var(--ww-font-heading);">Inquire of the Mayor</label>
                    <div class="input-group">
                        <input id="question" autocomplete="off" class="form-control" type="search" list="questions"
                            placeholder="Ask a yes/no question...">
                        <button id="question_submit" class="btn btn-primary px-4">Inquire</button>
                    </div>
                    {% if autocomplete_enabled is true %}
                    <datalist id="questions">
                        {% for q in common_questions %}
                        <option value="{{ q }}" />
                        {% endfor %}
                    </datalist>
                    {% endif %}
                </div>
            </div>
        </div>

        <!-- Mayor Panel (Special operations) -->
        <div id="mayor_display" class="mt-3" style="display: inline;" hidden>
            <div hidden id="mayor_controls" class="alert alert-secondary d-flex align-items-center justify-content-between p-3 bg-dark border-secondary">
                <span class="text-gold">You are the Mayor. Lead the town.</span>
                <button onclick="undo_answer('{{ game_id }}')" class="btn btn-warning btn-sm">Undo Last Token</button>
            </div>
            <div hidden id="mayor_question" class="ww-card mt-3">
                <!-- Mayor Q&A active layout gets loaded here -->
            </div>
        </div>
    </div>

    <!-- Active Voting or Results panel -->
    <div hidden=true id="dialog-box" class="ww-card border-gold mb-4">
        <!-- Loaded via socket when voting/finished phases trigger -->
    </div>

    <!-- Inquiry History list (The scrolling questions log) -->
    <div class="ww-card">
        <h4 class="text-gold border-bottom pb-2 mb-3" style="font-family: var(--ww-font-heading);">Chronicle of Inquiries</h4>
        <div class="questions" id="questions_div">
            <!-- Questions load here via WebSockets -->
        </div>
    </div>
</div>

<!-- Immersive Frosted Role Footer Info -->
<footer id="footer_role_information" class="footer fixed-bottom">
</footer>

{% endblock %}