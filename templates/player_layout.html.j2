<div class="player-table-container">
    <table class="player-table">
        {%- for player in players -%}
        <tr class="align-middle">
            {% if admin_view %}
            <td width="40" class="text-center">
                <button class="btn btn-danger btn-sm p-1"
                    onclick="boot_player('{{ game_id }}', '{{ player.player_sid }}')"
                    title="Exile {{ player.name }}"
                    style="line-height: 1; font-size: 1rem; width: 28px; height: 28px; border-radius: 50%;">
                    &times;
                </button>
            </td>
            {% endif %}
            
            <td id="voting" width="40" class="text-center">
                {% if player.voting %}
                <img src="{{ url_for('static', filename='img/voting-white.png') }}" width="24" height="24" 
                     class="img-fluid" style="filter: drop-shadow(0 0 5px var(--ww-accent-gold-glow));">
                {% endif %}
            </td>
            
            <td>
                <span class="d-flex align-items-center flex-wrap gap-2">
                    <span class="username" style="font-size: 1.1rem;">
                        {{ player.name }}
                    </span>

                    {% if player.admin %}
                    <span class="badge bg-dark border-secondary text-gold">Elder</span>
                    {% endif %}
                    
                    {% if player.mayor %}
                    <span class="badge bg-dark border-gold text-gold" style="box-shadow: 0 0 5px var(--ww-accent-gold-glow);">Mayor</span>
                    {% endif %}
                </span>
            </td>
            
            {# Tokens column spacing #}
            {%- if player.mayor -%}
                <td width="10"></td>
                {%- for t in mayor_token_count -%}
                    {%- if t.token.token_text == 'Yes/No' or t.token.token_text == 'Maybe' %}
                    <td class="text-center" width="60">
                        <span title="{{t.token.token_text}}" class="d-flex align-items-center justify-content-center gap-1">
                            <span style="font-size: 1.2rem;">{{ t.token.token_icon }}</span>
                            <span class="badge bg-dark border-secondary text-gold">{{ t.count }}</span>
                        </span>
                    </td>
                    {%- elif t.count > 0 -%}
                    <td class="text-center" width="60">
                        <span title="{{t.token.token_text}}" class="d-flex align-items-center justify-content-center" style="font-size: 1.2rem;">
                            {{ t.token.token_icon }}
                        </span>
                    </td>
                    {%- endif -%}
                {%- endfor -%}
            {% else %}
                {%- for t in player.token_count -%}
                    {%- if t.token.token_text == 'Yes' or t.token.token_text == 'No' or t.token.token_text == 'Maybe' %}
                    <td class="text-center" width="60">
                        <span title="{{t.token.token_text}}" class="d-flex align-items-center justify-content-center gap-1">
                            <span style="font-size: 1.2rem;">{{ t.token.token_icon }}</span>
                            <span class="badge bg-dark border-secondary text-gold">{{ t.count }}</span>
                        </span>
                    </td>
                    {%- elif t.count > 0 -%}
                    <td class="text-center" width="60">
                        <span title="{{t.token.token_text}}" class="d-flex align-items-center justify-content-center" style="font-size: 1.2rem;">
                            {{ t.token.token_icon }}
                        </span>
                    </td>
                    {%- endif -%}
                {%- endfor -%}
            {%- endif -%}
        </tr>
        {%- endfor -%}
    </table>

    {%- if spectators|length > 0 -%}
    <div class="mt-3 pt-2 border-top border-secondary">
        <h6 class="text-gold mb-2" style="font-family: var(--ww-font-heading); font-size: 0.85rem; letter-spacing: 0.1em; text-transform: uppercase;">Spectators in the Shadows</h6>
        <div class="d-flex flex-wrap gap-2">
            {%- for spectator in spectators -%}
            <span class="badge bg-dark border-secondary py-2 px-3" style="color: var(--ww-text-secondary);">{{ spectator }}</span>
            {%- endfor -%}
        </div>
    </div>
    {%- endif -%}
</div>