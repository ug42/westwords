<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Westwords | Social Deduction Word Game</title>
  
  {# Google Fonts & Material Symbols #}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  
  {# Bootswatch Darkly for Layout Utilities & Grid #}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@4.5.2/dist/darkly/bootstrap.min.css"
    integrity="sha384-nNK9n28pDUDDgIiIqZ/MiyO3F4/9vsMtReZK39klb/MtkZI3/LtjSjlmyVPS3KdN" crossorigin="anonymous">
  
  {# Theme CSS #}
  <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}" type="text/css" />
  
  <link rel="shortcut icon" href="{{ url_for('static', filename='favicon.ico') }}" />
</head>
<body>

<!-- Base socket connection & routing script -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/socket.io/4.5.4/socket.io.js"></script>
<script src="{{ url_for('static', filename='js/script.js') }}"></script>

<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"
    integrity="sha384-q8i/X+965DzO0rT7abK41JStQIAqVgRVzpbzo5smXKp4YfRvH+8abtTE1Pi6jizo"
    crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
    crossorigin="anonymous"></script>

<!-- Flash messages from Flask -->
{% with messages = get_flashed_messages() %}
{% if messages %}
<div class="container mt-3 position-fixed style-flashes" style="z-index: 1050; top: 60px; right: 20px; max-width: 350px;">
  {% for message in messages %}
  <div class="alert alert-warning alert-dismissible fade show" role="alert">
    {{ message }}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endwith %}

{% if game_id|length %}
<script>
  // Game state capture
  get_game_state('{{ game_id }}')
</script>
{% endif %}

{# Live Toast notifications #}
<div id="toast-container" class="toast align-items-center position-fixed bottom-0 end-0 m-3" role="alert" aria-live="assertive" aria-atomic="true" style="z-index: 1050;">
  <div class="d-flex modal-content">
    <div class="toast-body">
      Notification message.
    </div>
    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
  </div>
</div>
<iframe name="hidden_frame" hidden></iframe>

{# Atmospheric navbar #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top ww-navbar">
  <button class="navbar-toggler" type="button"
          aria-label="Toggle navigation"
          data-bs-toggle="offcanvas"
          data-bs-target="#offcanvasNav"
          aria-controls="offcanvasNav">
    <span class="navbar-toggler-icon"></span>
  </button>
  <a class="navbar-brand" href="#" id="title-bar-role">Westwords</a>
  <div class="ms-auto">
    <ul class="navbar-nav">
      <li class="nav-item">
        <span id="titlebar-username" class="navbar-text username">
          {{ session.username }}
        </span>
      </li>
    </ul>
  </div>
</nav>

{# Themed offcanvas navigation #}
<div class="offcanvas offcanvas-start text-bg-dark" tabindex="-1" id="offcanvasNav" aria-labelledby="offcanvasNavLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasNavLabel">WESTWORDS</h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <ul class="nav flex-column">
      <li class="nav-item">
        <a href="/" class="nav-link text-white px-0">
          <button class="btn btn-secondary w-100 mb-2 text-start">Home</button>
        </a>
      </li>
      <hr class="text-light my-2">
      
      {% if game_id|length %}
      <li class="nav-item">
        <button type="button" onclick="location.href='/spectate/{{ game_id }}'"
          class="btn btn-secondary w-100 mb-2 text-start" id="spectate" hidden>Spectate Game</button>
      </li>
      <li class="nav-item">
        <button type="button" onclick="location.href='/leave/{{ game_id }}'"
          class="btn btn-danger w-100 mb-2 text-start" id="leave_game">Quit Game</button>
      </li>
      <li class="nav-item" id="nav_game_reset" hidden>
        <button onclick="send_reset_req('{{ game_id }}'); "
          class="btn btn-danger w-100 mb-2 text-start">Reset Game</button>
      </li>
      <hr class="text-light my-2">
      {% else %}
      <li class="nav-item">
        <form method="post" action="/create" class="mb-2">
          <div class="mb-2">
            <input type="text" name="game_id" placeholder="Join game name..." autocomplete="off" class="form-control form-control-dark">
          </div>
          <button type="submit" class="btn btn-primary w-100">Join / Create</button>
        </form>
      </li>
      <hr class="text-light my-2">
      {% endif %}
      
      <li class="nav-item">
        <a href="/settings" class="nav-link text-white px-0">
          <button class="btn btn-secondary w-100 mb-2 text-start">Settings</button>
        </a>
      </li>

      <li class="nav-item">
        <a href="/privacy_policy" class="nav-link text-white px-0">
          <button class="btn btn-secondary w-100 mb-2 text-start">Privacy Policy</button>
        </a>
      </li>
    </ul>
  </div>
</div>

<main role="main" style="padding-top: 56px;">
  <div class="container mt-4">
    {# Bootstrap Modal used globally #}
    <div class="modal fade ww-modal" id="main-modal" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="modalLabel">Role Information</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <!-- Modal content injected by Javascript -->
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
    
    {% block body %}{% endblock %}
  </div>
</main>

</body>
</html>